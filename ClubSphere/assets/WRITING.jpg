.background {
    position: fixed;
    top: 0;
    right: 0;
    width: 45%; 
    height: 100vh; 

    background-image: url('Blue Background.jpg');
    background-size: cover;
    background-position: center;
    
    clip-path: ellipse(95% 100% at 100% 50%);
    
    z-index: -1;
    opacity: 0.9;
    
    display: flex;
    align-items: stretch;
}


