
/*Start Student page style(visual studio)*/
.profile{
position:fixed;
top:20px;
right:20px;
width:70px;
height:70px;
border-radius:50%;
border:0.5px solid #6A98C1;
background-color:white;

}
.profile:hover{ 
 transition: transform 0.2s ease-in-out, background-color 0.3s ease-in-out;
transform: scale(1.05);
	
}



.name{
text-align:center;
position: relative;
top:-80px;
left:50%;
transform:translateX(-50%); /*center exactly*/
font-size:50px;
font-family: "Segoe UI", Tahoma, Geneva, sans-serif;
 font-weight:700;
 padding-bottom:20px;
color: white;
    
}

