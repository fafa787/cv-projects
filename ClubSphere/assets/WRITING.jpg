/*Start Forget Password Page */

.newPass{
color:#808080;
text-align:center;
font-family: "Segoe UI", Tahoma, Geneva, sans-serif;
font-size:15px;
}
.reset{
	 position:relative;
	 right:-60px;
	 top:40px;
	 font-family: "Segoe UI", Tahoma, Geneva, sans-serif;
	 padding-left:30px;
	 padding-right:30px;
	 border-radius:15px;
