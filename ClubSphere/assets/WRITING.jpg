.description {
    text-align: center;
    font-size: 20px;
    max-width: 600px;
    margin: 200px auto 30px 100px;
    color: #0D47A1;
    line-height: 1.6;
    font-weight: 500;
	font-family: "Segoe UI", Tahoma, Geneva, sans-serif;
}

.activities a:link {
	text-decoration:none;
	
	
}
     
 .activities a:hover{
    transform: translateX(-50%) scale(1.1); 
    background-color: #BBDEFB;

}

.activities a {
    
	display:inline-block;
	background-color:white;
    border:solid 2px black;
	border-radius:20px;
	padding-right:20px;
	padding-left:20px;
	padding-top:20px;
	padding-bottom:20px;
	color:black;
    font-size:40px;
  	 font-family: "Segoe UI", Tahoma, Geneva, sans-serif;
	  font-weight:100;
      
   transition: transform 0.2s ease-in-out, background-color 0.3s ease-in-out;
   
  
}
body{
	 background-image: url('background.jpeg');
	background-repeat:repeat;
	margin-top:20px;
	margin-bottom:20px;
	margin-right:20px;
	margin-left:20px;
    
	
}

html, body {
    width: 100%;   /* Make sure the width is 100% */
    height: 100%;  /* Ensures full height */
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;  /* Prevent horizontal scrolling */
}
.topPart {
    background:linear-gradient(to bottom, #012e70, #3b5a89); 
    width: 100vw;  /* Ensures it covers the full viewport width */
    height: 100px; 
    position: fixed;  /* Keeps it fixed at the top */
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;  /* Ensures it stays above other content */
}


.logo{
	position:fixed;
	top:-89px;
	left:-30px;
    width: 300px; 
    height: 300px;
	z-index:3;
	
}
/*End student page style*/

/*Start of Login and registration page style*/



.login {
