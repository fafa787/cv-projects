/*------------------------------------------Start registered student page style---------------------------*/

/* إعدادات الصفحة الأساسية */
body {
	background-image: url("background2.jpeg");
    background-size: cover;
    font-family: "Segoe UI", Tahoma, Geneva, sans-serif;
    text-align: center;
    margin: 0;
    padding: 0;
}

/* تنسيق الهيدر */
header {
    background: linear-gradient(to bottom, #012e70, #3b5a89); 
    color: white;
    padding: 20px;
    font-size: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
	height:60px;
}

.header-left {
    position: absolute;
    left: 20px;
    display: flex;
    align-items: center;
}


.logo1 {
    width: 300px;
    height: 300px;
    margin-left: -50px;
    margin-top: 23px;
}

/*  الجدول */
.table-container {
    margin: 60px auto;
    width: 80%;
    background-color: white;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
}

/* تنسيق الجدول */
table {
    width: 100%;
    border-collapse: collapse;
}

/* تنسيق  الجدول */
thead {
    background-color: #012e70;
    color: white;
}

th, td {
    padding: 12px;
    border: 1px solid #ddd;
    text-align: center;
}

/* تنسيق عمود رقم الجوال */
td a[href^="tel"] {
    color: #007BFF; 
    text-decoration: none;
    font-weight: bold;
}

td a[href^="tel"]:hover {
    text-decoration: underline;
}


/* تنسيق البريد الإلكتروني */
td a {
    color: #0D47A1;
    text-decoration: none;
    font-weight: bold;
}

td a:hover {
    text-decoration: underline;
}

/* تنسيق زر الحذف */
.delete-btn {
    background-color: #D32F2F;
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 5px;
    cursor: pointer;
}

.delete-btn:hover {
    background-color: #B71C1C;
}

/* تنسيق زر الحفظ */
.save-btn {
    display: block;
    margin: 20px auto;
    background-color: #0D47A1;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.save-btn:hover {
    background-color: #1565C0;
}
/* تعديل تنسيق الفوتر */
.footer {
	margin-top: 130px;
    background: linear-gradient(to bottom, #012e70, #3b5a89);
    color: white;
    padding: 40px 0;
    font-size: 14px;
    width: 100%;
}

/* الفوتر يحتوي على أربعة أقسام مع توزيع المسافات */

.footer-container {
    display: flex;
    justify-content: flex-start; 
    align-items: flex-start; 
    text-align: left; 


/* كل قسم في الفوتر */
.footer-section1,
.footer-section2,
.footer-section3 ,
.footer-section4{
    flex: 1;
    margin: 8px;
    padding: 0 15px; 
	  text-align: left; 
}

/* إضافة خط عمودي بين الأقسام */
.footer-section1:not(:last-child),
.footer-section2:not(:last-child) {
    border-right: 2px solid #ddd;  
    padding-left: 50px;
}
.footer-section2{
    padding-right: 50px;
    margin-left: -22px; 
    
}

/* تنسيق الروابط في الفوتر */
.footer-menu {
     list-style-type: none;
    padding-left: 0;  
    text-align: left; 
}

.footer-menu li {
    margin-bottom: 10px;
}

.footer-menu li a {
    text-decoration: none;
    color: #ddd;
    font-size: 15px;
}

.footer-menu li a:hover {
    color: #47556c;
}

/* تنسيق العناوين داخل الفوتر */
.footer-section1 h4,
.footer-section2 h4,
.footer-section3 h4 {
    color: #ffffff;
    font-size: 22px;
    margin-bottom: 17px;
	 text-align: left;  
    margin-left: 0;  
}

/* تعديل النص في الفوتر الصغير */

.footer-smallprint {
    display: flex;
    justify-content: space-between; 
    align-items: center;
    font-size: 12px;
    color: #ddd;
    padding: 0 20px;
    width: 100%;
    margin-top: 5px;
    text-align: left; 
}

/* تنسيق الأيقونات في قسم Contact Us */
.social-icons {
    display: flex;
    justify-content: flex-start;  
    gap: 27px;  
    color: aliceblue;
}

.social-icons a {
    display: block;
    width: 45px;  
    height: 45px;  
    transition: transform 0.3s ease; 
}

.social-icons a img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1); 

/* عند المرور بالماوس على الأيقونة */
.social-icons a:hover {
    transform: scale(1.1); 
}

.social-icons a img:hover {
    filter: brightness(0.5); 
}

.footer-left,
.footer-right {
    margin: 0;
    padding: 0;
}

/* Footer responsive design */
@media (max-width: 768px) {
    .footer-container {
        flex-direction: column;
        align-items: center;
    }
}

/* تعديل تنسيق الفوتر الصغير */
.footer-smallprint {
    display: flex;
    justify-content: space-between;  
    align-items: center;
    font-size: 12px;
    color: #ddd;
    padding: 0 20px;  
    width: 100%;
    margin-top: 5px; 
}

/* تنسيق الخط الأفقي */
.footer-line {
    height: 1.75px; 
    background-color: #ddd; 
    margin: 20px 15px 0px 15px; 
}

/* النصوص على اليسار واليمين */
.footer-left,
.footer-right {
    margin: 0;  
    padding: 0; 
}

/* تنسيق الخريطة داخل الفوتر */
.footer-section3 {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-right: 50px;
}

.footer-map iframe {
    width: 100%;
    height: 175px; 
    border: none;
    margin-top: 10px;  
}

.footer-section4 {
    display: flex;
    justify-content: flex-start; 
    align-items: center;
    margin-left: 7px; 
    margin-left: 5px; 
}

.footer-logo {
    width: 300px; 
    height: 300px;
}
/*------------------------------------------End registered student page style---------------------------*/



